# Model provider access — the service owns credentials, never the plugin.
OPENROUTER_API_KEY=

# Optional provider-direct keys for delegates that need them
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Budget controls (cents; empty = unset defaults from config)
# SWITCHBOARD_JOB_BUDGET_CENTS=
# SWITCHBOARD_RUN_BUDGET_CENTS=
# SWITCHBOARD_MAX_CONCURRENT_RUNS=

# Local data roots (defaults shown; override for tests)
# SWITCHBOARD_DATA_DIR=~/.local/share/switchboard
# SWITCHBOARD_WORKSPACES_DIR=~/.local/share/switchboard/workspaces
# SWITCHBOARD_ARTIFACT_DIR=~/.local/share/switchboard/artifacts

# OpenCode host integration
# OPENCODE_CONFIG_DIR=
